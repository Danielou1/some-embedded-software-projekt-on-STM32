#include "potis/potis.h"

ADC_HandleTypeDef ADC_handle_structure;
DMA_HandleTypeDef DMA_handle_structure;
uint16_t samples[2] = { 236, 3782 };

static void potis_RCC_Config(void) {
	__HAL_RCC_GPIOA_CLK_ENABLE();
	__HAL_RCC_ADC1_CLK_ENABLE();
	__HAL_RCC_DMA2_CLK_ENABLE();
}

static void potis_GPIO_Init(void) {
	GPIO_InitTypeDef gpio_init_struct;

	gpio_init_struct.Pin = POTIS1 | POTIS2;
	gpio_init_struct.Mode = GPIO_MODE_ANALOG;
	gpio_init_struct.Speed = GPIO_SPEED_MEDIUM;

	HAL_GPIO_Init(POTIS_PORT, &gpio_init_struct);
}


static void potis_ADC1_Init(void) {

	ADC_handle_structure.Instance = ADC1;
	ADC_handle_structure.Init.ClockPrescaler = ADC_CLOCK_SYNC_PCLK_DIV6;
	ADC_handle_structure.Init.Resolution = ADC_RESOLUTION_12B;
	ADC_handle_structure.Init.DataAlign = ADC_DATAALIGN_RIGHT;
	ADC_handle_structure.Init.ScanConvMode = ENABLE;
	ADC_handle_structure.Init.EOCSelection = ADC_EOC_SINGLE_CONV;
	ADC_handle_structure.Init.ContinuousConvMode = DISABLE;
	ADC_handle_structure.Init.NbrOfConversion = 1;
	ADC_handle_structure.Init.ExternalTrigConv = ADC_SOFTWARE_START;
	ADC_handle_structure.Init.DMAContinuousRequests = ENABLE;
	ADC_handle_structure.DMA_Handle = &DMA_handle_structure;

	HAL_ADC_Init(&ADC_handle_structure);

	ADC_ChannelConfTypeDef ADC_channel_structure;
	ADC_channel_structure.Channel = ADC_CHANNEL_7;
	ADC_channel_structure.Rank = 1;
	ADC_channel_structure.SamplingTime = ADC_SAMPLETIME_3CYCLES;
	HAL_ADC_ConfigChannel(&ADC_handle_structure,
			&ADC_channel_structure);

	ADC_ChannelConfTypeDef ADC_channel_structure1;
	ADC_channel_structure1.Channel = ADC_CHANNEL_6;
	ADC_channel_structure1.Rank = 2;
	ADC_channel_structure1.SamplingTime = ADC_SAMPLETIME_3CYCLES;
	HAL_ADC_ConfigChannel(&ADC_handle_structure,
			&ADC_channel_structure1);
}


void potis_Init(void){
	potis_RCC_Config();
	potis_GPIO_Init();
	potis_ADC1_Init();
}
void potis_start_ADC1(){
	HAL_ADC_Start(&ADC_handle_structure);
}

uint32_t potis_get_val(uint8_t poti_num) {

	if (poti_num == 1)
		return samples[0];
	else if (poti_num == 2)
		return samples[1];
	return 0;
}

uint32_t potis_get_millivolt_val(uint8_t poti_num) {
	return (potis_get_val(poti_num) * 3300) / 4095;
}

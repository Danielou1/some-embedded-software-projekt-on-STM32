#include <lcd/lcd.h>
#include "stm32f4xx.h"
#include "potis/potis.h"
#include <stdio.h>

int main(void)
{
	HAL_Init();

	/* Initialization of the LCD */
	lcd_init();
	potis_init();
	HAL_StatusTypeDef ret;
	char buf[32];


	//potis_start_ADC1();

	while(1) {
		potis_start_ADC1();
		ret = HAL_ADC_PollForConversion(&ADC_handle_structure, 1000);
		if(ret != HAL_TIMEOUT)
		{
		  uint32_t ADC_val = HAL_ADC_GetValue(&ADC_handle_structure);
		  /* ... */
		  sprintf(buf, "adc: %ld", ADC_val);
		  lcd_draw_text_at_line(buf, 7, BLACK, 2, WHITE);
		}

	}
}

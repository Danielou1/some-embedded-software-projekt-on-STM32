/*
 * @file main.c
 * @author:
 * @brief The sampled values will be printed with a bargraph
 */

 /* Includes */
#include <stdio.h>
#include <lcd/lcd.h>
#include "my_lcd/my_lcd.h"
#include "potis/potis.h"
#include "stm32f4xx.h"

int main(void) {

	//Initialization
	HAL_Init();
	lcd_init();
	potis_Init();

	//LCD buffers
	char buf_potis_1[64];
	char buf_potis_2[64];

	while (1) {

		//Print sampled value on LCD
		sprintf(buf_potis_1, "Potis 1: %4lu", potis_get_millivolt_val(POTIS_1));
		lcd_draw_text_at_line(buf_potis_1, 1, BLACK, 2, WHITE);

		sprintf(buf_potis_2, "Potis 2: %4lu", potis_get_millivolt_val(POTIS_2));
		lcd_draw_text_at_line(buf_potis_2, 10, BLACK, 2, WHITE);

		//Draw Bargraph for potis_1 and potis_2
		draw_bar_graph(0, 50, 240, 50, potis_get_val(POTIS_1) / 4, RED, BLACK);
		draw_bar_graph(0, 200, 240, 50, potis_get_val(POTIS_2) / 4, BLUE,
		BLACK);
	}
}

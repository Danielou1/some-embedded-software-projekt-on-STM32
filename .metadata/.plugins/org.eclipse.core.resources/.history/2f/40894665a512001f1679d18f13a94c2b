/* Includes */
#include "potis_dma/potis_dma.h"

/* Global variables */
ADC_HandleTypeDef ADC_with_dma_handle_structure;
DMA_HandleTypeDef DMA_handle_structure;

uint16_t samples[2] = { 0, 0 };
uint16_t average_samples[200] = { 0 }; // 200 for the 2 channels
DMA_HandleTypeDef DMA_handle_structure;


/**
 * @brief 	Enable the Tact for GPIOA, ADC1 and DMA2
 * @param 	None
 * @retval  None
 */
static void potis_dma_RCC_Config(void) {
	__HAL_RCC_GPIOA_CLK_ENABLE();
	__HAL_RCC_ADC1_CLK_ENABLE();
	__HAL_RCC_DMA2_CLK_ENABLE();
}

/**
 * @brief 	Initializes GPIO for the potentiometers
 * @param 	None
 * @retval  None
 */
static void potis_dma_GPIO_Init(void) {
	GPIO_InitTypeDef gpio_init_struct;

	gpio_init_struct.Pin = POTIS1 | POTIS2;
	gpio_init_struct.Mode = GPIO_MODE_ANALOG;
	gpio_init_struct.Speed = GPIO_SPEED_MEDIUM;

	HAL_GPIO_Init(POTIS_PORT, &gpio_init_struct);
}

/**
 * @brief 	Initializes ADC and channels for the potentiometers using DMA
 * @param 	None
 * @retval  None
 */
static void potis_dma_ADC1_Init(void) {

	ADC_with_dma_handle_structure.Instance = ADC1;
	ADC_with_dma_handle_structure.Init.ClockPrescaler = ADC_CLOCK_SYNC_PCLK_DIV4;
	ADC_with_dma_handle_structure.Init.Resolution = ADC_RESOLUTION_12B;
	ADC_with_dma_handle_structure.Init.DataAlign = ADC_DATAALIGN_RIGHT;
	ADC_with_dma_handle_structure.Init.ScanConvMode = ENABLE;
	ADC_with_dma_handle_structure.Init.EOCSelection = ADC_EOC_SINGLE_CONV;
	ADC_with_dma_handle_structure.Init.ContinuousConvMode = ENABLE;
	ADC_with_dma_handle_structure.Init.NbrOfConversion = 1;
	ADC_with_dma_handle_structure.Init.ExternalTrigConv = ADC_SOFTWARE_START;
	ADC_with_dma_handle_structure.Init.DMAContinuousRequests = ENABLE;
	ADC_with_dma_handle_structure.DMA_Handle = &DMA_handle_structure;

	HAL_ADC_Init(&ADC_with_dma_handle_structure);

	ADC_ChannelConfTypeDef ADC_channel_structure;
	ADC_channel_structure.Channel = ADC_CHANNEL_7;
	ADC_channel_structure.Rank = 1;
	ADC_channel_structure.SamplingTime = ADC_SAMPLETIME_84CYCLES;
	HAL_ADC_ConfigChannel(&ADC_with_dma_handle_structure,
			&ADC_channel_structure);

	ADC_ChannelConfTypeDef ADC_channel_structure1;
	ADC_channel_structure1.Channel = ADC_CHANNEL_6;
	ADC_channel_structure1.Rank = 2;
	ADC_channel_structure1.SamplingTime = ADC_SAMPLETIME_84CYCLES;
	HAL_ADC_ConfigChannel(&ADC_with_dma_handle_structure,
			&ADC_channel_structure1);

}


/**
 * @brief 	Initializes the resources needed by DMA2 for the potentiometers.
 * @param 	None
 * @retval  None
 */
static void potis_dma_DMA2_Init(void) {

	DMA_handle_structure.Instance = DMA2_Stream0;
	DMA_handle_structure.Init.Channel = DMA_CHANNEL_0;
	DMA_handle_structure.Init.Direction = DMA_PERIPH_TO_MEMORY;
	DMA_handle_structure.Init.PeriphInc = DMA_PINC_DISABLE;
	DMA_handle_structure.Init.MemInc = DMA_MINC_ENABLE;
	DMA_handle_structure.Init.PeriphDataAlignment = DMA_PDATAALIGN_HALFWORD;
	DMA_handle_structure.Init.MemDataAlignment = DMA_MDATAALIGN_HALFWORD;
	DMA_handle_structure.Init.Mode = DMA_CIRCULAR;
	DMA_handle_structure.Init.Priority = DMA_PRIORITY_HIGH;
	DMA_handle_structure.Init.FIFOMode = DMA_FIFOMODE_DISABLE;

	HAL_DMA_Init(&DMA_handle_structure);
}

/**
 * @brief 	Initialization of all the necessary components
 * @param 	None
 * @retval  None
 */
void potis_dma_Init(void) {
	potis_dma_RCC_Config();
	potis_dma_GPIO_Init();
	potis_dma_DMA2_Init();
	potis_dma_ADC1_Init();
	HAL_ADC_Start_DMA(&ADC_with_dma_handle_structure, (uint32_t*) samples, 200);
}

/**
 * @brief 	Get sampled ADC values of the potentiometers
 * @param 	poti_num	potentiometer number
 * 			POTIS_1 is for the potentiometer closest to the SPI port.
 * 			POTIS_2 is for the potentiometer furthest from the SPI port.
 * @retval  returns the numerical value of the sampled signal on a potentiometer
 */
uint32_t potis_dma_get_val(uint8_t poti_num) {

	if (poti_num == POTIS_1)
		return samples[0];
	else if (poti_num == POTIS_2)
		return samples[1];
	return 0;
}

/**
 * @brief 	Converts and returns sampled ADC values of the potentiometers
 * @param 	poti_num	potentiometer number
 * @retval  returns the numerical value in millivolt of the sampled signal on a potentiometer
 */
uint32_t potis_dma_get_millivolt_val(uint8_t poti_num) {
	return (potis_dma_get_val(poti_num) * 3300) / 4095;
}

/**
 * @brief 	Get the average of sampled ADC values of the potentiometers
 * @param 	poti_num	potentiometer number
 * @retval  returns the average value of the sampled signal on a potentiometer
 */
uint32_t potis_dma_get_val_average(uint8_t poti_num) {
	uint16_t average = 0;
	if (poti_num == POTIS_1) {

		for (int i = 0; i < 200; i++) {
			if (i % 2 == 0) {
				average += average_samples[i];
			}
		}
	} else if (poti_num == POTIS_2) {
		for (int i = 0; i < 200; i++) {
			if (i % 3 == 0) {
				average += average_samples[i];
			}
		}
	}

	return average / 100 / 4;
}

/**
 * @brief 	Converts and returns the average of the sampled ADC values of the potentiometers
 * @param 	poti_num	potentiometer number
 * @retval  returns the numerical value in millivolt of the sampled signal on a potentiometer
 */
uint32_t potis_dma_get_val_average_millivolt(uint8_t poti_num) {
	return (potis_dma_get_val_average(poti_num) * 3300) / 4095;
}


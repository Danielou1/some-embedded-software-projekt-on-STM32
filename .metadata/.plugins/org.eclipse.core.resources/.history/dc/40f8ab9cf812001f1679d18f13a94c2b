/*
 * @file potis_dma.h
 * @author:
 * @brief Potis_DMA Headerfile for Potentiometers working with DMA
 */


#ifndef POTIS_DMA_POTIS_DMA_H_
#define POTIS_DMA_POTIS_DMA_H_

/* Includes */
#include "stm32f4xx.h"

/* Public Preprocessor defines */
//Defines for our PINS and PORT
#define ADC_1 GPIO_PIN_7
#define ADC_2 GPIO_PIN_6

#define POTIS1 ADC_1
#define POTIS2 ADC_2

#define POTIS_PORT GPIOA

/* Public functions prototypes */

/**
 * @brief Potentiometer initialization
 */
void potis_dma_Init(void);

/**
 * @brief function that returns the values received from the potentiometers
 * @param  poti_num Potentiometer Number
 */
uint32_t potis_dma_get_val(uint8_t poti_num);

/**
 * @brief function that converts and returns in millivolt the values received from the potentiometers
 * @param  poti_num Potentiometer Number
 */
uint32_t potis_dma_get_millivolt_val(uint8_t poti_num);

/**
 * @brief function that returns the average of the values received from the potentiometers
 * @param  poti_num Potentiometer Number
 */
uint32_t potis_dma_get_val_average(uint8_t poti_num);

/**
 * @brief function that converts and returns in millivolt the average of the values received from the potentiometers
 * @param  poti_num Potentiometer Number
 */
uint32_t potis_dma_get_val_average_millivolt(uint8_t poti_num);

uint16_t potis_dma_get_adc1_value(void); //For the timer

#endif /* POTIS_DMA_POTIS_DMA_H_ */
